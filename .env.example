APP_ENV=production
APP_NAME=Steam Intelligence
APP_URL=https://steam.example.com
API_URL=https://steam-api.example.com
APP_SECRET_KEY=CHANGE_ME_SECRET_KEY_AT_LEAST_32_CHARS
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
DATABASE_URL=postgresql+psycopg://steam:CHANGE_ME@postgres:5432/steam_intelligence
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Steam Configuration
STEAM_WEB_API_KEY=
STEAM_API_BASE_URL=https://api.steampowered.com
STEAM_STORE_COUNTRY=us
STEAM_STORE_LANGUAGE=english

# Third-party Sources & Platforms (disabled by default until authorized / configured)
STEAMSPY_ENABLED=false
IGDB_ENABLED=false
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
ITCH_ENABLED=false
ITCH_API_KEY=
EPIC_ENABLED=false
GOG_ENABLED=false
PCGAMINGWIKI_ENABLED=false

# AI Provider Configuration
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage and Observability
EXPORT_STORAGE_PATH=/app/exports
EXPORT_RETENTION_DAYS=30
LOG_LEVEL=INFO
